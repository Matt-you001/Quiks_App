{
  "expo": {
    "name": "Quiks",
    "slug": "quiks",
    "scheme": "quiks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/quiks-icon-1024.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1F33"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.quiks.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quiks-adaptive-foreground.png",
        "backgroundColor": "#0B1F33"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "f2fa2ea0-d0d5-4f61-a469-0eb14602adfa"
      }
    }
  }
}
