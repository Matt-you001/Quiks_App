{
  "expo": {
    "name": "Quiks Children",
    "slug": "quiks",
    "scheme": "quiks-children",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/quiks-children-icon-1024.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#7A2CC8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.quiks.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quiks-children-adaptive-foreground.png",
        "backgroundColor": "#7A2CC8"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "APP_VARIANT": "children",
      "EXPO_PUBLIC_APP_VARIANT": "children",
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "f2fa2ea0-d0d5-4f61-a469-0eb14602adfa"
      }
    }
  }
}
